# 公文系統機器設定範本 — 複製此檔為 .env 並填入實際值
# .env 不得 commit 或外傳

# INBOX_DIR：掃描機輸出資料夾或手動放置 PDF 的路徑
INBOX_DIR=<公文掃描檔或下載位置資料夾路徑>
# ARCHIVE_BASE_DIR：程式依公文發文年度於此目錄下建立對應年度歸檔資料夾
ARCHIVE_BASE_DIR=<公文歸檔根目錄>
# ARCHIVE_SUBDIR：年份目錄下的歸檔子目錄名稱（預設為「歸檔公文」）
ARCHIVE_SUBDIR=<歸檔子目錄名稱>
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\Users\<使用者名稱>\AppData\Local\Microsoft\WinGet\Packages\oschwartz10612.Poppler_Microsoft.Winget.Source_8wekyb3d8bbwe\poppler-25.07.0\Library\bin
SPREADSHEET_ID=<Google_Sheets_ID>
ANTHROPIC_API_KEY=<Anthropic_API_Key>
GOOGLE_API_KEY=<Google_AI_Studio_API_Key>
# OWN_ORG：本公司／機關完整名稱；發文字號機關符合此名稱時自動登記為「發文」
OWN_ORG=<公司或機關全名>
