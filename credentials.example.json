{
  "type": "service_account",
  "project_id": "<Google Cloud 專案 ID>",
  "private_key_id": "<私鑰 ID：40 字元十六進位字串>",
  "private_key": "-----BEGIN RSA PRIVATE KEY-----\n<Base64 編碼私鑰，從 Google Cloud 下載的 JSON 金鑰檔中複製整段內容>\n-----END RSA PRIVATE KEY-----\n",
  "client_email": "<服務帳號名稱>@<專案 ID>.iam.gserviceaccount.com",
  "client_id": "<服務帳號數字 ID>",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/<服務帳號名稱>%40<專案 ID>.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}
